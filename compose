services:
  meet:
    build:
      context: https://github.com/livekit-examples/meet.git
      dockerfile_inline: |
        FROM node:20-alpine AS builder
        WORKDIR /app
        RUN npm install -g pnpm
        COPY package.json pnpm-lock.yaml* ./
        RUN pnpm install --frozen-lockfile
        COPY . .
        
        # Удаляем проблемные картинки, чтобы build не падал
        RUN rm -rf public/background-images || true
        
        RUN pnpm build

        FROM node:20-alpine
        WORKDIR /app
        RUN npm install -g pnpm
        COPY --from=builder /app ./
        EXPOSE 3000
        CMD ["pnpm", "start"]
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      - LIVEKIT_API_KEY
      - LIVEKIT_API_SECRET
      - LIVEKIT_URL
