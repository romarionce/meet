services:
  meet:
    build:
      context: https://github.com/livekit-examples/meet.git
      dockerfile_inline: |
        FROM node:20-alpine AS builder
        WORKDIR /app
        RUN npm install -g pnpm
        
        COPY package.json pnpm-lock.yaml* ./
        RUN pnpm install --frozen-lockfile
        COPY . .
        
        # Убираем импорты фоновых картинок и даём массиву правильный тип
        RUN node -e " \
          const fs = require('fs'); \
          let c = fs.readFileSync('lib/CameraSettings.tsx', 'utf8'); \
          c = c.replace(/import Desk from [^;]+;/g, ''); \
          c = c.replace(/import Nature from [^;]+;/g, ''); \
          c = c.replace(/const BACKGROUND_IMAGES = \[[\s\S]*?\];/, 'const BACKGROUND_IMAGES: { name: string; path: { src: string } }[] = [];'); \
          fs.writeFileSync('lib/CameraSettings.tsx', c); \
        "
        
        RUN pnpm build

        FROM node:20-alpine
        WORKDIR /app
        RUN npm install -g pnpm
        COPY --from=builder /app ./
        EXPOSE 3000
        CMD ["pnpm", "start"]
    restart: unless-stopped
    ports:
      - "3000:3000"
    environment:
      - LIVEKIT_API_KEY
      - LIVEKIT_API_SECRET
      - LIVEKIT_URL
